# Google Sheets Integration
# Get your URL from Google Apps Script deployment or Sheet.best
# See GOOGLE_SHEETS_SETUP.md for detailed setup instructions
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Version Mode Configuration
# 'full' = Complete detailed content, NO masterclass promotion
# 'minimal' = Limited content with masterclass promotion to encourage sign-up
# Default: 'full'
VITE_VERSION_MODE=full

# Test Mode Configuration
# Set to 'true' to enable the random answers test button (DEV ONLY)
# Set to 'false' or remove for production
# Default: not set (button hidden)
VITE_ENABLE_TEST_MODE=false
